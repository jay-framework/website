name: templates-data-list
description: List view for templates

props:
  - name: contentDir
    kind: required
  - name: file
    kind: required

tags:
  - tag: items
    type: sub-contract
    repeated: true
    trackBy: slug
    phase: slow
    tags:
      - tag: slug
        type: data
        dataType: string
      - tag: name
        type: data
        dataType: string
      - tag: githubUrl
        type: data
        dataType: string
      - tag: exampleUrl
        type: data
        dataType: string
      - tag: coverImage
        type: data
        dataType: string