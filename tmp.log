      '<g class="message" data-from="SR" data-to="HTML" data-label="pending HTML inside target div" data-line-style="solid" data-arrow-head="filled" data-self="false">\n' +
      '  <line x1="91.8055" y1="370" x2="275.4235" y2="370" stroke="var(--_line)" stroke-width="1" marker-end="url(#seq-arrow)" />\n' +
