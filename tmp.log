      '<h3><code>import:</code> block</h3>\n' +
      '<pre class="md-code"><code class="language-yaml"><span class="token keyword">import</span><span class="token punctuation">:</span>\n' +
      '  localAlias<span class="token punctuation">:</span> contract<span class="token punctuation">-</span>subpath.jay<span class="token punctuation">-</span>contract</code></pre>\n' +
      '<ul>\n' +
      '<li>Key is a local alias used in type expressions</li>\n' +
      '<li>Value is the contract subpath (same format as <code>plugin.yaml</code> and <code>package.json</code> exports)</li>\n' +
