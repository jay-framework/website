      'interface JayInit<span class="token operator">&lt;</span>T<span class="token operator">&gt;</span> <span class="token punctuation">{</span>\n' +
      `  readonly __brand<span class="token operator">:</span> <span class="token string">'JayInit'</span><span class="token punctuation">;</span>\n` +
