      '  <span class="token keyword">const</span> components<span class="token operator">:</span> ProjectComponent<span class="token punctuation">[</span><span class="token punctuation">]</span> <span class="token operator">=</span> <span class="token punctuation">[</span><span class="token punctuation">]</span><span class="token punctuation">;</span>\n' +
      '\n' +
      '  <span class="token keyword">try</span> <span class="token punctuation">{</span>\n' +
