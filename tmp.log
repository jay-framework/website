      '    <span class="token string">&quot;@jay-framework/ui-kit&quot;</span><span class="token punctuation">:</span> <span class="token string">&quot;^0.21.0&quot;</span>\n' +
      '  <span class="token punctuation">}</span><span class="token punctuation">,</span>\n' +
      '  <span class="token string">&quot;devDependencies&quot;</span><span class="token punctuation">:</span> <span class="token punctuation">{</span>\n' +
