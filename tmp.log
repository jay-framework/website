      '    maxBound<span class="token punctuation">:</span> number\n' +
      '    ranges<span class="token punctuation">:</span>\n' +
      '      <span class="token punctuation">-</span> rangeId<span class="token punctuation">:</span> string\n' +
      '        label<span class="token punctuation">:</span> string\n' +
      '        minValue?<span class="token punctuation">:</span> number\n' +
      '        maxValue?<span class="token punctuation">:</span> number\n' +
      '        isSelected<span class="token punctuation">:</span> boolean</code></pre>\n' +
      '<h3>Type notation rules</h3>\n' +
      '<table>\n' +
      '<thead>\n' +
      '<tr>\n' +
      '<th>Notation</th>\n' +
      '<th>Meaning</th>\n' +
      '<th>Example</th>\n' +
      '</tr>\n' +
      '</thead>\n' +
      '<tbody><tr>\n' +
      '<td><code>string</code>, <code>number</code>, <code>boolean</code></td>\n' +
      '<td>Primitives</td>\n' +
      '<td><code>name: string</code></td>\n' +
      '</tr>\n' +
      '<tr>\n' +
      '<td><code>enum(a | b | c)</code></td>\n' +
      '<td>Enum type</td>\n' +
      '<td><code>sortBy?: enum(asc | desc)</code></td>\n' +
      '</tr>\n' +
      '<tr>\n' +
      '<td><code>propName?:</code></td>\n' +
      '<td>Optional property</td>\n' +
      '<td><code>filters?: ...</code></td>\n' +
      '</tr>\n' +
      '<tr>\n' +
      '<td>YAML list <code>- ...</code></td>\n' +
      '<td>Array of objects</td>\n' +
      '<td><code>items: \\n- id: string</code></td>\n' +
      '</tr>\n' +
      '<tr>\n' +
      '<td><code>- importedName</code></td>\n' +
      '<td>Array of imported type</td>\n' +
      '<td><code>products: \\n- productCard</code></td>\n' +
      '</tr>\n' +
      '<tr>\n' +
      '<td><code>importedName</code></td>\n' +
      '<td>Imported contract type</td>\n' +
