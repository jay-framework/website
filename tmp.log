      '<span class="token punctuation">}</span></code></pre>\n' +
      '<h2>Single Element</h2>\n' +
      '<pre class="md-code"><code class="language-typescript"><span class="token keyword">export</span> interface HTMLElementProxy<span class="token operator">&lt;</span>ViewState<span class="token punctuation">,</span> ElementType <span class="token keyword">extends</span> HTMLElement<span class="token operator">&gt;</span> <span class="token punctuation">{</span>\n' +
