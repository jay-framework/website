      '      data:\n' +
      '          text: string\n' +
      '          done: boolean\n' +
      '          dataId: string\n' +
      '    <span class="token tag">&lt;/script</span><span class="token punctuation">&gt;</span>\n' +
      '  <span class="token tag">&lt;/head</span><span class="token punctuation">&gt;</span>\n' +
      '  <span class="token tag">&lt;body</span><span class="token punctuation">&gt;</span>\n' +
      '    <span class="token tag">&lt;div</span> <span class="token attribute">data-id</span><span class="token punctuation">=</span><span class="token string">&quot;{dataId}&quot;</span><span class="token punctuation">&gt;</span>\n' +
      '      <span class="token tag">&lt;span</span><span class="token punctuation">&gt;</span>{text} - {done?done:tdb}<span class="token tag">&lt;/span</span><span class="token punctuation">&gt;</span>\n' +
      '      <span class="token tag">&lt;button</span> <span class="token attribute">ref</span><span class="token punctuation">=</span><span class="token string">&quot;done&quot;</span><span class="token punctuation">&gt;</span>done<span class="token tag">&lt;/button</span><span class="token punctuation">&gt;</span>\n' +
      '      <span class="token tag">&lt;button</span> <span class="token attribute">ref</span><span class="token punctuation">=</span><span class="token string">&quot;remove&quot;</span><span class="token punctuation">&gt;</span>remove<span class="token tag">&lt;/button</span><span class="token punctuation">&gt;</span>\n' +
      '    <span class="token tag">&lt;/div</span><span class="token punctuation">&gt;</span>\n' +
      '  <span class="token tag">&lt;/body</span><span class="token punctuation">&gt;</span>\n' +
      '<span class="token tag">&lt;/html</span><span class="token punctuation">&gt;</span></code></pre>\n' +
      '<p><code>item.ts</code></p>\n' +
      `<pre class="md-code"><code class="language-typescript"><span class="token keyword">import</span> <span class="token punctuation">{</span> render<span class="token punctuation">,</span> ItemVS<span class="token punctuation">,</span> ItemElement <span class="token punctuation">}</span> <span class="token keyword">from</span> <span class="token string">'./item.jay.html'</span><span class="token punctuation">;</span>\n` +
      `<span class="token keyword">import</span> <span class="token punctuation">{</span> createEffect<span class="token punctuation">,</span> createState<span class="token punctuation">,</span> createEvents<span class="token punctuation">,</span> makeJayComponent <span class="token punctuation">}</span> <span class="token keyword">from</span> <span class="token string">'jay-hooks'</span><span class="token punctuation">;</span>\n` +
      '\n' +
      '<span class="token keyword">export</span> interface ItemData <span class="token punctuation">{</span>\n' +
      '  text<span class="token operator">:</span> string<span class="token punctuation">;</span>\n' +
      '  dataId<span class="token operator">:</span> string<span class="token punctuation">;</span>\n' +
      '  onRemove<span class="token operator">:</span> <span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token operator">=&gt;</span> <span class="token keyword">void</span><span class="token punctuation">;</span>\n' +
      '<span class="token punctuation">}</span>\n' +
      '\n' +
      '<span class="token keyword">export</span> interface ItemComponent <span class="token keyword">extends</span> JayComponent<span class="token operator">&lt;</span>ItemData<span class="token punctuation">,</span> ItemVS<span class="token punctuation">,</span> ItemElement<span class="token operator">&gt;</span> <span class="token punctuation">{</span><span class="token punctuation">}</span>\n' +
      '\n' +
      '<span class="token keyword">export</span> <span class="token keyword">function</span> <span class="token function">Item</span><span class="token punctuation">(</span>props<span class="token operator">:</span> ItemData<span class="token punctuation">)</span><span class="token operator">:</span> ItemComponent <span class="token punctuation">{</span>\n' +
      '  <span class="token keyword">const</span> <span class="token punctuation">[</span>text<span class="tok'... 30328 more characters,
