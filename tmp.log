      '  sortBy?<span class="token punctuation">:</span> enum(relevance <span class="token punctuation">|</span> price_asc <span class="token punctuation">|</span> price_desc <span class="token punctuation">|</span> name_asc <span class="token punctuation">|</span> name_desc <span class="token punctuation">|</span> newest)\n' +
      '  page?<span class="token punctuation">:</span> number\n' +
      '  pageSize?<span class="token punctuation">:</span> number\n' +
      '\n' +
      '<span class="token keyword">outputSchema</span><span class="token punctuation">:</span>\n' +
      '  products<span class="token punctuation">:</span>\n' +
      '    <span class="token punctuation">-</span> productCard\n' +
      '  totalCount<span class="token punctuation">:</span> number\n' +
