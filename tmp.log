      '<td>forEach with dynamic text per item</td>\n' +
      '<td>Text bindings work</td>\n' +
      '</tr>\n' +
      '<tr>\n' +
      '<td>3.3</td>\n' +
      '<td>Add/remove items (interactive)</td>\n' +
      '<td>DOM updates; trackBy preserved</td>\n' +
      '</tr>\n' +
      '<tr>\n' +
      '<td>3.4</td>\n' +
      '<td>Reorder items</td>\n' +
      '<td>Order updates correctly</td>\n' +
      '</tr>\n' +
      '<tr>\n' +
