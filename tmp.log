      '        <span class="token tag">&lt;div</span> <span class="token attribute">forEach</span><span class="token punctuation">=</span><span class="token string">&quot;items&quot;</span> <span class="token attribute">trackBy</span><span class="token punctuation">=</span><span class="token string">&quot;id&quot;</span><span class="token punctuation">&gt;</span>\n' +
