      '<span class="token punctuation">}</span>\n' +
      '\n' +
      '<span class="token keyword">export</span> <span class="token keyword">const</span> ProductPage <span class="token operator">=</span> <span class="token function">makeJayPageComponent</span><span class="token punctuation">(</span>\n' +
