      '  addToCart<span class="token operator">:</span> HTMLElementProxy<span class="token operator">&lt;</span>ProductPageViewState<span class="token punctuation">,</span> HTMLButtonElement<span class="token operator">&gt;</span><span class="token punctuation">;</span>\n' +
