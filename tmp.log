      '  <text x="913.0060000000001" y="126.95000000000002" text-anchor="middle" font-size="11" font-weight="400" fill="var(--_text-sec)" dy="3.8499999999999996">inline template</text>\n' +
      '</g>\n' +
      '<g class="edge-label" data-from="B" data-to="I" data-label="template from file">\n' +
      '  <rect x="311.639" y="165.60000000000002" width="92.49400000000003" height="30.3" rx="2" ry="2" fill="var(--bg)" stroke="var(--_inner-stroke)" stroke-w'... 40346 more characters,
