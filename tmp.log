      '  <text x="525.1017499999999" y="80" font-size="11" text-anchor="middle" font-weight="400" fill="var(--_text-muted)"><tspan x="525.1017499999999" dy="-3.3000000000000007">link (import page comp.) +</tspan><tspan x="525.1017499999999" dy="14.3"> app settings</tspan></text>\n' +
      '</g>\n' +
      '<g class="message" data-from="comp" data-to="page" data-label="(params, system params)[]" data-line-style="solid" data-arrow-head="filled" data-self="false">\n' +
      '  <line x1="604.8694999999999" y1="145" x2="445.33399999999995" y2="145" stroke="var(--_line)" stroke-width="1" marker-end="url(#seq-arrow)" />\n' +
      '  <text x="525.1017499999999" y="135" font-size="11" text-anchor="middle" font-weight="400" fill="var(--_text-muted)" dy="3.8499999999999996">(params, system params)[]</text>\n' +
      '</g>\n' +
      '<g class="message" data-from="page" data-to="comp" data-label="params, system params + \n' +
      'app settings" data-line-style="solid" data-arrow-head="filled" data-self="false">\n' +
      '  <line x1="445.33399999999995" y1="185" x2="604.8694999999999" y2="185" stroke="var(--_line)" stroke-width="1" marker-end="url(#seq-arrow)" />\n' +
