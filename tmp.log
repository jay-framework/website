      '<td>Empty array</td>\n' +
      '<td>No items; no errors</td>\n' +
      '</tr>\n' +
      '</tbody></table>\n' +
      '<p><strong>Fixtures:</strong> <code>page-foreach-static</code>, <code>page-foreach-dynamic</code>, <code>page-foreach-empty</code></p>\n' +
      '<hr>\n' +
      '<h2>4. slowForEach</h2>\n' +
      '<p><strong>Goal:</strong> Verify server-rendered iteration hydrates with correct viewState/carryForward.</p>\n' +
      '<table>\n' +
      '<thead>\n' +
      '<tr>\n' +
      '<th>Test</th>\n' +
      '<th>Setup</th>\n' +
      '<th>Assert</th>\n' +
      '</tr>\n' +
      '</thead>\n' +
      '<tbody><tr>\n' +
      '<td>4.1</td>\n' +
      '<td>slowForEach with items</td>\n' +
      '<td>SSR HTML present; hydration succeeds</td>\n' +
      '</tr>\n' +
      '<tr>\n' +
      '<td>4.2</td>\n' +
      '<td>Per-item viewState</td>\n' +
      '<td>Each item has correct data</td>\n' +
      '</tr>\n' +
      '<tr>\n' +
      '<td>4.3</td>\n' +
      '<td>Per-item carryForward</td>\n' +
      '<td>carryForwards resolve (full key + suffix fallback)</td>\n' +
      '</tr>\n' +
      '<tr>\n' +
      '<td>4.4</td>\n' +
      '<td>Interactive updates within items</td>\n' +
      '<td>Updates work post-hydration</td>\n' +
      '</tr>\n' +
      '<tr>\n' +
      '<td>4.5</td>\n' +
