      '</g>\n' +
      '<g class="message" data-from="SR" data-to="SR" data-label="await Promise.all(promises)" data-line-style="solid" data-arrow-head="filled" data-self="true">\n' +
      '  <polyline points="91.8055,300 121.8055,300 121.8055,320 91.8055,320" fill="none" stroke="var(--_line)" stroke-width="1" marker-end="url(#seq-arrow)" />\n' +
