      '    --_text-sec:      var(--muted, color-mix(in srgb, var(--fg) 60%, var(--bg)));\n' +
      '    --_text-muted:    var(--muted, color-mix(in srgb, var(--fg) 40%, var(--bg)));\n' +
      '    --_text-faint:    co'... 35639 more characters,
