      '        <span class="token string">`Make sure to call: registerService(${serviceName.toUpperCase()}_SERVICE, ...)`</span><span class="token punctuation">,</span>\n' +
      '    <span class="token punctuation">)</span><span class="token punctuation">;</span>\n' +
      '  <span class="token punctuation">}</span>\n' +
      '  <span class="token keyword">return</span> service<span class="token punctuation">;</span>\n' +
      '<span class="token punctuation">}</span>\n' +
      '\n' +
      '<span class="token keyword">export</span> <span class="token keyword">function</span> <span class="token function">clearServiceRegistry</span><span class="token punctuation">(</span><span class="token punctuation">)</span><span class="token operator">:</span> <span class="token keyword">void</span> <span class="token punctuation">{</span>\n' +
      '  serviceRegistry<span class="token punctuation">.</span><span class="token function">clear</span><span class="token punctuation">(</span><span class="token punctuation">)</span><span class="token punctuation">;</span>\n' +
