      '    products<span class="token punctuation">:</span>\n' +
      '      type<span class="token punctuation">:</span> array\n' +
      '      items<span class="token punctuation">:</span>\n' +
      '        type<span class="token punctuation">:</span> object\n' +
      '        properties<span class="token punctuation">:</span>\n' +
      '          _id<span class="token punctuation">:</span>\n' +
      '            type<span class="token punctuation">:</span> string\n' +
      '          name<span class="token punctuation">:</span>\n' +
      '            type<span class="token punctuation">:</span> string\n' +
      '          <span class="token comment"># ... 20 more lines of duplicated contract schema</span>\n' +
      '    totalCount<span class="token punctuation">:</span>\n' +
      '      type<span class="token punctuation">:</span> number\n' +
      '    hasMore<span class="token punctuation">:</span>\n' +
      '      type<span class="token punctuation">:</span> boolean</code></pre>\n' +
      '<h4>After (compact jay-type notation)</h4>\n' +
      '<pre class="md-code"><code class="language-yaml"><span class="token keyword">name</span><span class="token punctuation">:</span> searchProducts\n' +
      '<span class="token keyword">description</span><span class="token punctuation">:</span> Search products...\n' +
      '\n' +
      '<span class="token keyword">import</span><span class="token punctuation">:</span>\n' +
      '  productCard<span class="token punctuation">:</span> product<span class="token punctuation">-</span>card.jay<span class="token punctuation">-</span>contract\n' +
      '\n' +
      '<span class="token keyword">inputSchema</span><span class="token punctuation">:</span>\n' +
      '  query<span class="token punctuation">:</span> string\n' +
