<html>
  <head>
    <style>
      /* ── Header ── */
      .site-header {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 50;
        background: rgba(14, 19, 34, 0.7);
        backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(60, 73, 78, 0.2);
      }
      .header-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 16px var(--margin-mobile);
      }
      @media (min-width: 768px) {
        .header-inner { padding: 16px var(--margin-desktop); }
      }
      @keyframes brand-shimmer {
        0%  { background-position: -200% center; }
        100%  { background-position:  400% center; }
      }
      .header-brand {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-display);
        font-size: 32px;
        font-weight: 700;
        letter-spacing: -0.01em;
        text-decoration: none;
      }
      .brand-icon {
        width: 32px;
        height: 32px;
        flex-shrink: 0;
      }
      .brand-text-wrap {
        position: relative;
        display: inline-block;
      }
      .header-brand .brand-base {
        color: var(--color-primary);
      }
      .header-brand .brand-shine {
        position: absolute;
        top: 0;
        left: 0;
        background: linear-gradient(105deg,
          transparent 40%, rgba(255, 255, 255, 0.85) 45%,
          rgba(165, 231, 255, 0.9) 50%, rgba(255, 255, 255, 0.85) 55%, transparent 60%);
        background-size: 300% auto;
        background-repeat: no-repeat;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        animation: brand-shimmer 5s linear infinite;
      }
      .header-nav {
        display: none;
        align-items: center;
        gap: 32px;
      }
      @media (min-width: 768px) {
        .header-nav { display: flex; }
      }
      .header-nav a {
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 500;
        color: var(--color-text-muted);
        text-decoration: none;
        transition: color 0.3s;
      }
      .header-nav a:hover { color: var(--color-primary); text-decoration: none; }
      .header-actions { display: flex; align-items: center; gap: 16px; }
      .btn-get-started {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--color-primary-container);
        color: var(--color-on-primary-container);
        padding: 8px 24px;
        border: none;
        border-radius: var(--radius-default);
        font-family: var(--font-display);
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        text-decoration: none;
      }
      .btn-get-started:hover {
        transform: scale(1.05);
        text-decoration: none;
      }
      /* Hide Get Started + GitHub on mobile, show hamburger */
      .header-actions .btn-get-started { display: none; }
      .header-actions .header-github {
        display: none;
        align-items: center;
        color: var(--color-text-muted);
        transition: color 0.3s;
      }
      /* Hamburger button */
      .hamburger-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background: none;
        border: 1px solid rgba(165, 231, 255, 0.2);
        border-radius: var(--radius-default);
        cursor: pointer;
        color: var(--color-text);
        padding: 0;
      }
      .hamburger-icon {
        display: flex;
        flex-direction: column;
        gap: 4px;
        width: 18px;
      }
      .hamburger-icon span {
        display: block;
        height: 2px;
        background: currentColor;
        border-radius: 1px;
        transition: transform 0.3s, opacity 0.3s;
      }
      /* Mobile menu */
      #mobile-menu-toggle { display: none; }
      .mobile-menu {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        z-index: 49;
        background: var(--color-surface-lowest, #0a0f1e);
        padding: 80px var(--margin-mobile) 32px;
        flex-direction: column;
        gap: 8px;
        overflow-y: auto;
      }
      #mobile-menu-toggle:checked ~ .site-header .hamburger-icon span:nth-child(1) {
        transform: translateY(6px) rotate(45deg);
      }
      #mobile-menu-toggle:checked ~ .site-header .hamburger-icon span:nth-child(2) {
        opacity: 0;
      }
      #mobile-menu-toggle:checked ~ .site-header .hamburger-icon span:nth-child(3) {
        transform: translateY(-6px) rotate(-45deg);
      }
      #mobile-menu-toggle:checked ~ .mobile-menu {
        display: flex;
      }
      .mobile-menu a {
        font-family: var(--font-display);
        font-size: 18px;
        font-weight: 600;
        color: var(--color-text-muted);
        text-decoration: none;
        padding: 12px 0;
        border-bottom: 1px solid rgba(60, 73, 78, 0.2);
        transition: color 0.3s;
      }
      .mobile-menu a:hover {
        color: var(--color-primary);
        text-decoration: none;
      }
      .mobile-menu .mobile-menu-actions {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-top: 24px;
      }
      .mobile-menu .mobile-menu-github {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--color-text-muted);
        font-family: var(--font-mono);
        font-size: 14px;
      }
      .mobile-menu .mobile-menu-github svg {
        flex-shrink: 0;
      }
      @media (min-width: 768px) {
        .header-actions .btn-get-started { display: inline-flex; }
        .header-actions .header-github { display: flex; }
        .hamburger-toggle { display: none; }
        .mobile-menu { display: none !important; }
      }
    </style>
  </head>
  <body>
    <input type="checkbox" id="mobile-menu-toggle">
    <header class="site-header">
      <nav class="header-inner">
        <a href="/" class="header-brand"><img src="https://static.wixstatic.com/shapes/c569b3_448c7c0df8024b2786885af2054a24a8.svg" alt="" class="brand-icon" width="32" height="32" loading="eager"><span class="brand-text-wrap"><span class="brand-base">Jay Framework</span><span class="brand-shine" aria-hidden="true">Jay Framework</span></span></a>
        <div class="header-nav">
          <a href="#feedback-loop">Ecosystem</a>
          <a href="#agent-roles">Agents</a>
          <a href="#contract">The Contract</a>
          <a href="#value">Performance</a>
        </div>
        <div class="header-actions">
          <a class="header-github" href="https://github.com/jay-framework/jay/" target="_blank" aria-label="GitHub"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><g fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></g></svg></a>
          <a class="btn-get-started" href="#cta">Get Started</a>
          <label for="mobile-menu-toggle" class="hamburger-toggle" aria-label="Menu">
            <div class="hamburger-icon"><span></span><span></span><span></span></div>
          </label>
        </div>
      </nav>
    </header>
    <div class="mobile-menu">
      <a href="#feedback-loop" onclick="document.getElementById('mobile-menu-toggle').checked=false">Ecosystem</a>
      <a href="#agent-roles" onclick="document.getElementById('mobile-menu-toggle').checked=false">Agents</a>
      <a href="#contract" onclick="document.getElementById('mobile-menu-toggle').checked=false">The Contract</a>
      <a href="#value" onclick="document.getElementById('mobile-menu-toggle').checked=false">Performance</a>
      <div class="mobile-menu-actions">
        <a class="mobile-menu-github" href="https://github.com/jay-framework/jay/" target="_blank"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><g fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></g></svg> GitHub</a>
        <a class="btn-get-started" href="#cta" onclick="document.getElementById('mobile-menu-toggle').checked=false" style="text-align: center; justify-content: center;">Get Started</a>
      </div>
    </div>
  </body>
</html>
