<html>
  <head>
    <script type="application/jay-data" contract="./site-footer.jay-contract"></script>
    <style>
      /* ── Footer ── */
      .site-footer {
        background: var(--color-surface-lowest);
        border-top: 1px solid rgba(60, 73, 78, 0.2);
        padding: 48px 0;
      }
      .footer-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-gutter);
      }
      @media (min-width: 768px) {
        .footer-grid { grid-template-columns: 1fr 1fr; }
      }
      @media (min-width: 1024px) {
        .footer-grid { grid-template-columns: 2fr 1fr 1fr 2fr; }
      }
      .footer-brand {
        font-family: var(--font-display);
        font-size: 24px;
        font-weight: 800;
        color: var(--color-primary);
        margin-bottom: 24px;
      }
      .footer-copyright {
        color: var(--color-text-muted);
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 16px;
      }
      .footer-heading {
        color: var(--color-primary);
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        margin-bottom: 24px;
      }
      .footer-links { list-style: none; display: flex; flex-direction: column; gap: 12px; }
      .footer-links a {
        color: var(--color-text-muted);
        font-family: var(--font-mono);
        font-size: 12px;
        transition: color 0.3s;
        text-decoration: none;
      }
      .footer-links a:hover { color: var(--color-secondary-dim); text-decoration: none; }
    </style>
  </head>
  <body>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <div class="footer-brand">Jay Framework</div>
            <p class="footer-copyright">Built with Jay Stack. The self-correcting visual ecosystem for AI-native web development.</p>
          </div>
          <div>
            <h3 class="footer-heading">Resources</h3>
            <ul class="footer-links">
              <li><a href="/docs">Documentation</a></li>
              <li><a href="https://github.com/jay-framework/jay/" target="_blank">GitHub</a></li>
            </ul>
          </div>
          <div>
            <h3 class="footer-heading">Legal</h3>
            <ul class="footer-links">
              <li><a href="#">Security Policy</a></li>
              <li><a href="#">Privacy</a></li>
            </ul>
          </div>
          <div>
            <h3 class="footer-heading">Learn More</h3>
            <p class="footer-copyright">Jay bridges the gap between probabilistic AI outputs and deterministic engineering standards.</p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
